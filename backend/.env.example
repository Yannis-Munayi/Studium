# Studium backend environment (infrastructure §6.2).
#
# GENERATED FILE -- do not edit by hand. It is rendered from
# studium/ops/secrets.py by `studium ops secrets render`, and
# tests/ops/test_secrets.py fails on a diff. That is deliberate: §16's Tier 1
# line is "Secret variable names match between production, local, and CI
# configurations", and a hand-maintained example file is the copy that drifts.
#
# Copy to .env.local (gitignored) and fill in. Values here are placeholders and
# none of them work.
#
# Rotation cadences are §6.3's. `studium ops secrets check --environment
# production` reports what a live environment is missing without printing a
# single value.


# --- Secrets -- never committed, never logged, never in fly.toml ---------------

# Model access for every agent (agent runtime §4).
# Read by the Anthropic SDK directly, so the name is theirs rather than ours and cannot be prefixed STUDIUM_.
# Rotation: quarterly (§6.3).
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings for hybrid retrieval (retrieval §6).
# Rotation: quarterly (§6.3).
# Absent: retrieval runs on stub embeddings and falls back to keyword-only (retrieval §16). Search still answers; ranking quality is not what was measured.
VOYAGE_API_KEY=pa-...

# LLM tracing (§7.1).
# Rotation: quarterly (§6.3).
# Absent: no LLM traces; agent_traces rows are still written.
LANGFUSE_SECRET_KEY=sk-lf-...

# Error reporting (§7.2).
# A DSN is write-only and often treated as public. Classified secret here because anyone holding it can flood the error budget, and the §8.1 error-rate alert reads that budget.
# Rotation: quarterly (§6.3).
# Absent: unhandled exceptions reach the Fly log and nowhere else. No alert fires for the §8.1 error-rate condition, because nothing is counting.
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Application connection. Cannot UPDATE or DELETE the append-only tables (migration 0003).
# Contains credentials, which is what makes it a secret.
# Rotation: never (§6.3).
STUDIUM_DATABASE_URL=postgresql+psycopg://studium:studium@localhost:5432/studium

# Owner connection for the retention, erasure and roll-up jobs, which must DELETE from append-only tables.
# Rotation: never (§6.3).
# Absent: falls back to STUDIUM_DATABASE_URL, which is correct locally where both roles are the same superuser and wrong in production, where the retention worker would fail its first DELETE.
STUDIUM_OWNER_DATABASE_URL=postgresql+psycopg://studium:studium@localhost:5432/studium

# Cookie authentication signing (§6.1).
# Declared and unused. Frontend §14's auth is a placeholder (DIVERGENCES-FRONTEND F7) and nothing signs a cookie yet. It is here because §6.1 names it and §6.3 gives it a rotation trigger -- 'rotated when auth infrastructure gets rebuilt' -- and a secret that appears in the registry the day auth lands is a secret nobody has to remember to add. See DIVERGENCES-INFRASTRUCTURE (N7).
# Rotation: on rebuild (§6.3).
STUDIUM_SESSION_SECRET=<32 random bytes, base64>

# Ed25519 private seed for portfolio credentials (§11, evaluation §12.3). 32 bytes, base64.
# §9.1: the one thing whose loss cannot be recovered from the running system. Two independent encrypted copies, per §9.1.
# Rotation: annually (§6.3).
# Absent: credentials cannot be issued; the learner sees evaluation §16's message and a retry job picks it up. Work items are hash-chained and recorded as unsigned rather than failing the turn.
STUDIUM_SIGNING_KEY=<32 random bytes, base64>

# R2 credentials (§6.1, 'when provisioned').
# Rotation: quarterly (§6.3).
STUDIUM_R2_ACCESS_KEY_ID=<r2 access key id>

# R2 credentials (§6.1, 'when provisioned').
# Rotation: quarterly (§6.3).
STUDIUM_R2_SECRET_ACCESS_KEY=<r2 secret access key>


# --- Configuration -- safe to commit; the deployment sets these in fly.toml ----

# LLM tracing (§7.1). Paired with LANGFUSE_SECRET_KEY.
# Public in Langfuse's own sense -- it identifies the project and cannot write without the secret half. Kept out of fly.toml anyway: it is half of a credential pair, and splitting a pair across a committed file and a secret store is how the wrong half gets rotated.
# Rotation: quarterly (§6.3).
# Absent: no LLM traces; agent_traces rows are still written.
LANGFUSE_PUBLIC_KEY=pk-lf-...

# Langfuse Cloud endpoint (§7.1). Self-hosting is a v2 option.
LANGFUSE_HOST=https://cloud.langfuse.com

# Stable public name of the current signing key, quoted in every credential's issuer_public_key_id.
# Not a secret -- it is published at /api/portfolio/keys. It lives in Fly secrets anyway, because splitting a key and its identifier across two stores is how a rotation updates one and not the other.
STUDIUM_SIGNING_KEY_ID=studium-2026

# Which studium.storage implementation serves source files: 'local' (Fly volume) or 'r2'.
# §4.5: migration to R2 is a configuration change, not a code change.
STUDIUM_STORAGE_BACKEND=local

# Filesystem root for the local storage backend (§4.5).
STUDIUM_SOURCE_STORAGE_ROOT=/data/sources

# Cloudflare R2 bucket for source files, once §14.3's 30GB trigger fires.
STUDIUM_R2_BUCKET=studium-sources

# R2 S3-compatible endpoint.
STUDIUM_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# Which environment this process is (§5.1). Isolates local activity in Langfuse traces and selects the §6 required-secret set.
STUDIUM_ENV=local

# Retrieval §14's cache warmer. Off unless set to 1, because it bills a reranker on a timer forever.
STUDIUM_WARM_CACHE=0

# §12.1's nightly retention pass, in-process. Off unless set to 1, so a developer's checkout never deletes anything.
STUDIUM_RETENTION_WORKER=0

# Where §8.3's alerts are delivered. One address at MVP.
STUDIUM_ALERT_EMAIL=ops@example.com

# Tier 3 opt-in. Every paid test skips unless this is 1.
STUDIUM_RUN_PAID_TESTS=0

# Where OpenTelemetry spans go (§7.3). Langfuse accepts OTLP, so LLM and HTTP traces share a trace id.
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
